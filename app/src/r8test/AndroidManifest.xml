<?xml version="1.0" encoding="utf-8"?>
<!-- Só no r8test (teste local, nunca distribuído): Login/Amigos abríveis por "adb shell am start -n", sem passar pela MainActivity/wizard; e o servidor
     local por HTTPS com a CA do Caddy instalada no emulador (docs-social/servidor-local.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity android:name="com.pokelocation.app.social.ui.LoginActivity" android:exported="true"
            tools:replace="android:exported" />
        <activity android:name="com.pokelocation.app.social.ui.FriendsActivity" android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
