<?xml version="1.0" encoding="utf-8"?>
<!-- CA local do Caddy (instalada como CA de usuário no emulador). Cleartext segue proibido. -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
