<?xml version="1.0" encoding="utf-8"?>
<!-- Login/Amigos abríveis por "adb shell am start -n" (sem o wizard da MainActivity) e servidor local por HTTPS. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity android:name="com.pokelocation.app.social.ui.LoginActivity" android:exported="true"
            tools:replace="android:exported" />
        <activity android:name="com.pokelocation.app.social.ui.FriendsActivity" android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
