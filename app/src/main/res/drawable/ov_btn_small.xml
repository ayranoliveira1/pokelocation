<?xml version="1.0" encoding="utf-8"?>
<!-- Botão pequeno (classic): borda cinza; borda primária quando selecionado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/overlay_button_bg" />
            <stroke android:width="2dp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/overlay_button_bg" />
            <stroke android:width="1dp" android:color="@color/outline" />
        </shape>
    </item>
</selector>
