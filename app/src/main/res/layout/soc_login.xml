<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/soc_login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/base_toolbar" />

    <include android:id="@+id/soc_signal" layout="@layout/soc_signal" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/gap_large">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gap_large" android:text="@string/soc_login_hint"
                android:textAppearance="@style/TextAppearance.PokeLocation.PanelBody" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gap" android:hint="@string/soc_email">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/soc_login_email"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:autofillHints="emailAddress" android:inputType="textEmailAddress" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/soc_password" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/soc_login_password"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:autofillHints="password" android:imeOptions="actionDone"
                    android:inputType="textPassword" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/soc_login_username_box"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap" android:hint="@string/soc_username"
                android:visibility="gone" app:prefixText="\@" app:helperText="@string/soc_username_rules">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/soc_login_username"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:importantForAutofill="no" android:inputType="textNoSuggestions|textVisiblePassword"
                    android:maxLength="21" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <ProgressBar android:id="@+id/soc_login_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap" android:indeterminate="true" android:visibility="invisible" />
            <Button android:id="@+id/soc_login_sign_in" style="@style/Widget.PokeLocation.PanelButton.Filled"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap" android:text="@string/soc_sign_in" />
            <Button android:id="@+id/soc_login_sign_up" style="@style/Widget.PokeLocation.PanelButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap" android:text="@string/soc_sign_up" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/gap_large"
                android:text="@string/soc_or" android:textAppearance="@style/TextAppearance.PokeLocation.PanelBody" />
            <!-- Sign in with Google (diretrizes de marca): "G" oficial à esquerda do texto, fundo/borda/texto do
                 tema (values/values-night soc_colors), texto sem caixa alta, toque ≥ 48 dp. -->
            <com.google.android.material.button.MaterialButton android:id="@+id/soc_login_google"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap" android:minHeight="48dp"
                android:text="@string/soc_google" android:textAllCaps="false"
                android:textColor="@color/soc_google_on" android:textSize="14sp"
                app:backgroundTint="@color/soc_google_bg" app:strokeColor="@color/soc_google_stroke"
                app:strokeWidth="1dp" app:cornerRadius="4dp"
                app:icon="@drawable/soc_ic_google" app:iconTint="@null" app:iconGravity="textStart"
                app:iconSize="20dp" app:iconPadding="10dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
