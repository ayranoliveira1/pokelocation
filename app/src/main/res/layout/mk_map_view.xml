<?xml version="1.0" encoding="utf-8"?>
<!-- Conteúdo do MarkerMapView (FrameLayout). O MapView entra em mk_map_container no 1º attach. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@+id/mk_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/mk_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_panel"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="@dimen/gap"
        android:visibility="gone">
        <TextView
            android:id="@+id/mk_coords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/copy"
            android:padding="@dimen/gap"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/mk_move" style="@style/Widget.PokeLocation.PanelButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/move" />
            <Button android:id="@+id/mk_remove" style="@style/Widget.PokeLocation.PanelButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/delete"
                android:textColor="@color/danger" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mk_move_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_panel"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="@dimen/gap"
        android:visibility="gone">
        <Button android:id="@+id/mk_move_cancel" style="@style/Widget.PokeLocation.PanelButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel" />
        <Button android:id="@+id/mk_move_ok" style="@style/Widget.PokeLocation.PanelButton.Filled"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ok" />
    </LinearLayout>

    <TextView
        android:id="@+id/mk_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_panel"
        android:elevation="4dp"
        android:paddingStart="@dimen/gap_large"
        android:paddingTop="@dimen/gap"
        android:paddingEnd="@dimen/gap_large"
        android:paddingBottom="@dimen/gap"
        android:text="@string/mk_map_hint"
        android:textColor="@color/on_surface"
        android:textSize="14sp" />
</merge>
