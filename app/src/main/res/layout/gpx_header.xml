<?xml version="1.0" encoding="utf-8"?>
<!-- Cabeçalho de pasta: seta recolher/expandir, nome, "Add all in folder" (import) ou remover pasta (export). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gap"
    android:paddingEnd="@dimen/gap">

    <ImageView
        android:id="@+id/gpx_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_expand_less"
        app:tint="@color/on_surface_variant" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/gap"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_folder"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/gpx_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="@color/on_surface" />

    <Button
        android:id="@+id/gpx_header_action"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gpx_add_all_folder"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/gpx_header_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/gpx_cd_remove_folder"
        android:src="@drawable/ic_delete"
        android:visibility="gone"
        app:tint="@color/on_surface_variant" />
</LinearLayout>
