<?xml version="1.0" encoding="utf-8"?>
<!-- Tipo "classic": janela única (09 §2.3). Lock = toque curto no centro do stick. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:id="@+id/ov_route_top" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/ov_r_prev" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_route_prev" android:src="@drawable/ic_skip_previous" />
        <TextView android:id="@+id/ov_r_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/ov_pill"
            android:minWidth="36dp" android:gravity="center" android:paddingStart="6dp" android:paddingTop="2dp"
            android:paddingEnd="6dp" android:paddingBottom="2dp" android:textColor="@color/on_surface" android:textSize="11sp" />
        <ImageView android:id="@+id/ov_r_next" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_route_next" android:src="@drawable/ic_skip_next" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ov_route_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/ov_r_stop" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_route_stop" android:src="@drawable/ic_stop" android:tint="@color/danger" />
        <ImageView android:id="@+id/ov_suspend" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_suspend" android:src="@drawable/ov_ic_suspend" android:visibility="gone" />
        <ImageView android:id="@+id/ov_r_pause" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_route_pause" android:src="@drawable/ic_pause" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ov_rec_pill" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/ov_rec_stop" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_record_stop" android:src="@drawable/ic_stop" android:tint="@color/danger" />
        <ImageView android:id="@+id/ov_rec_add" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_record_add" android:src="@drawable/ic_add" />
        <ImageView android:id="@+id/ov_rec_map" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_record_map" android:src="@drawable/ic_map" android:visibility="gone" />
        <ImageView android:id="@+id/ov_rec_save" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_record_save" android:src="@drawable/ic_check" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageView android:id="@+id/ov_move" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_move" android:src="@drawable/ic_move" />
        <ImageView android:id="@+id/ov_map" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_map" android:src="@drawable/ic_map" />
        <ImageView android:id="@+id/ov_teleport" style="@style/ov_style_btn_small"
            android:contentDescription="@string/teleport" android:src="@drawable/ic_target" />
        <FrameLayout android:id="@+id/ov_chat_box" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone">
            <ImageView android:id="@+id/ov_chat" style="@style/ov_style_btn_small"
                android:contentDescription="@string/soc_chat_title" android:src="@drawable/soc_ic_chat" />
            <TextView android:id="@+id/ov_chat_badge" android:layout_width="wrap_content" android:layout_height="16dp"
                android:layout_gravity="top|end" android:background="@drawable/bg_pill" android:gravity="center"
                android:minWidth="16dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:textColor="@color/on_primary"
                android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
        </FrameLayout>
        <ImageView android:id="@+id/ov_pogo" style="@style/ov_style_btn_small"
            android:contentDescription="@string/pogo_map_layer" android:src="@drawable/pogo_ic_pokemon"
            android:visibility="gone" />
    </LinearLayout>
    <com.pokelocation.app.overlay.ui.JoystickView android:id="@+id/ov_stick"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ov_gap" android:layout_marginBottom="@dimen/ov_gap"
        android:contentDescription="@string/ov_cd_joystick" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageView android:id="@+id/ov_sp_walk" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_walk" android:src="@drawable/ic_walk" />
        <ImageView android:id="@+id/ov_sp_jog" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_jog" android:src="@drawable/ic_jog" />
        <ImageView android:id="@+id/ov_sp_run" style="@style/ov_style_btn_small"
            android:contentDescription="@string/ov_cd_run" android:src="@drawable/ic_run" />
    </LinearLayout>
    <include layout="@layout/ov_autosuspend" />
</LinearLayout>
