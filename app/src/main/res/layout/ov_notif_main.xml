<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews da notificação do :overlay (F52). Só views suportadas por RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/ov_notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <TextView
        android:id="@+id/ov_notif_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="@string/ov_svc_tap_inject"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ov_notif_stop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tint="@color/primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ov_svc_stop"
            android:src="@drawable/ic_stop" />

        <ImageView
            android:id="@+id/ov_notif_hide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tint="@color/primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ov_svc_hide"
            android:src="@drawable/ic_visibility_off" />

        <ImageView
            android:id="@+id/ov_notif_share"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tint="@color/primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_share" />

        <ImageView
            android:id="@+id/ov_notif_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tint="@color/primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ov_svc_map"
            android:src="@drawable/ic_map" />

        <ImageView
            android:id="@+id/ov_notif_save"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tint="@color/primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/save"
            android:src="@drawable/ic_favorite" />

        <ImageView
            android:id="@+id/ov_notif_route_stop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tint="@color/primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ov_svc_route_stop"
            android:src="@drawable/ic_stop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ov_notif_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tint="@color/primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ov_svc_pause"
            android:src="@drawable/ic_pause"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ov_notif_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tint="@color/primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ov_svc_next"
            android:src="@drawable/ic_skip_next"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
