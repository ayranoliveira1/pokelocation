<?xml version="1.0" encoding="utf-8"?>
<!-- Linha da WidgetConfigActivity: item, cabeçalho de seção ou "No items selected!" (o adapter ajusta). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground" android:gravity="center_vertical"
    android:minHeight="56dp" android:orientation="horizontal"
    android:paddingStart="16dp" android:paddingEnd="4dp">
    <ImageView android:id="@+id/widget_config_icon" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginEnd="16dp" android:importantForAccessibility="no" app:tint="?attr/colorPrimary" />
    <TextView android:id="@+id/widget_config_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:ellipsize="end" android:maxLines="2"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurface" />
    <ImageButton android:id="@+id/widget_config_action" android:layout_width="48dp" android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless" />
</LinearLayout>
