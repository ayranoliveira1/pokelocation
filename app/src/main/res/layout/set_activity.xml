<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/set_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/base_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/set_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/gap_large">

            <TextView
                android:id="@+id/set_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary_container"
                android:paddingStart="@dimen/gap_large"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/gap_large"
                android:paddingBottom="12dp"
                android:text="@string/set_hint_next_start"
                android:textColor="@color/on_primary_container"
                android:textSize="@dimen/text_small"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
