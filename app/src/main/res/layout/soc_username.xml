<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/soc_username_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/base_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/gap_large">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/gap_large" android:text="@string/soc_username_explain"
                android:textAppearance="@style/TextAppearance.PokeLocation.PanelBody" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/soc_username_box"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/soc_username" app:prefixText="\@" app:helperText="@string/soc_username_rules">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/soc_username_input"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:imeOptions="actionDone" android:importantForAutofill="no"
                    android:inputType="textNoSuggestions|textVisiblePassword" android:maxLength="21" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <ProgressBar android:id="@+id/soc_username_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap" android:indeterminate="true" android:visibility="invisible" />
            <Button android:id="@+id/soc_username_save" style="@style/Widget.PokeLocation.PanelButton.Filled"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap" android:enabled="false" android:text="@string/soc_username_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
