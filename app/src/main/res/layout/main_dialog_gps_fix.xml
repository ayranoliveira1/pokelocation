<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/panel_padding"
        android:paddingTop="@dimen/gap"
        android:paddingEnd="@dimen/panel_padding">

        <CheckBox
            android:id="@+id/main_dlg_fix_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_dlg_fix_default" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="@dimen/gap"
            android:text="@string/main_dlg_fix_default_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <CheckBox
            android:id="@+id/main_dlg_fix_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_dlg_fix_1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="@dimen/gap"
            android:text="@string/main_dlg_fix_1_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <CheckBox
            android:id="@+id/main_dlg_fix_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_dlg_fix_2" />

        <TextView
            android:id="@+id/main_dlg_fix_2_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/main_dlg_fix_2_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
