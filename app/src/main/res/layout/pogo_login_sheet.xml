<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/gap_large"
    android:paddingTop="@dimen/gap"
    android:paddingEnd="@dimen/gap_large"
    android:paddingBottom="24dp">
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_large" android:text="@string/pogo_sheet_title"
        android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnSurface" />
    <!-- mesmo botão de marca do soc_login (diretrizes do Sign in with Google) -->
    <com.google.android.material.button.MaterialButton android:id="@+id/pogo_sheet_google"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
        android:text="@string/soc_google" android:textAllCaps="false"
        android:textColor="@color/soc_google_on" android:textSize="14sp"
        app:backgroundTint="@color/soc_google_bg" app:strokeColor="@color/soc_google_stroke"
        app:strokeWidth="1dp" app:cornerRadius="4dp"
        app:icon="@drawable/soc_ic_google" app:iconTint="@null" app:iconGravity="textStart"
        app:iconSize="20dp" app:iconPadding="10dp" />
    <TextView android:id="@+id/pogo_sheet_google_hint"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.button.MaterialButton android:id="@+id/pogo_sheet_discord"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:minHeight="48dp"
        android:text="@string/pogo_continue_discord" android:textColor="@android:color/white"
        app:backgroundTint="@color/pogo_discord" app:icon="@drawable/pogo_ic_discord"
        app:iconTint="@android:color/white" app:iconGravity="textStart" app:iconSize="20dp" app:iconPadding="10dp" />
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap" android:text="@string/pogo_discord_hint"
        android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
