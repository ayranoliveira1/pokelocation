<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_settings_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:orientation="vertical">

    <include layout="@layout/base_toolbar" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout android:id="@+id/widget_settings_choose" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                android:minHeight="72dp" android:gravity="center_vertical" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/widget_choose_items" android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/widget_choose_items_sub" android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="8dp"
                android:text="@string/widget_display" android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:text="@string/widget_theme" android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <RadioGroup android:id="@+id/widget_settings_theme" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="16dp">
                <RadioButton android:id="@+id/widget_settings_theme_light" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="@string/widget_theme_light" />
                <RadioButton android:id="@+id/widget_settings_theme_dark" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="@string/widget_theme_dark" />
                <RadioButton android:id="@+id/widget_settings_theme_system" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="@string/widget_theme_system" />
            </RadioGroup>

            <LinearLayout android:id="@+id/widget_settings_group_row" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground" android:gravity="center_vertical"
                android:minHeight="72dp" android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/widget_group" android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/widget_group_sub" android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/widget_settings_group"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:clickable="false" android:focusable="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
