<?xml version="1.0" encoding="utf-8"?>
<!-- Cabeçalho de seção do export (WayPoints / Routes): recolhe a seção inteira, mostra a contagem. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_container"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gap_large"
    android:paddingEnd="@dimen/gap_large">

    <TextView
        android:id="@+id/gpx_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/primary" />

    <TextView
        android:id="@+id/gpx_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/gap"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/on_surface_variant" />

    <ImageView
        android:id="@+id/gpx_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_expand_less"
        app:tint="@color/on_surface_variant" />
</LinearLayout>
