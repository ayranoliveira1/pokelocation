<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/gap"
    android:layout_marginEnd="@dimen/gap"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingTop="@dimen/gap"
        android:paddingBottom="@dimen/gap"
        android:paddingStart="@dimen/gap_large"
        android:paddingEnd="@dimen/gap">

        <ImageView
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_folder"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_large"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/routes_folder_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/routes_folder_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <ImageView
            android:id="@+id/routes_folder_end"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/routes_drag"
            android:padding="@dimen/gap"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@color/on_surface_variant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
