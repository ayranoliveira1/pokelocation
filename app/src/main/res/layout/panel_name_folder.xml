<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="@dimen/panel_padding">
    <TextView android:id="@+id/panel_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.PokeLocation.PanelTitle" />
    <EditText android:id="@+id/panel_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_large" android:hint="@string/name" android:importantForAutofill="no"
        android:inputType="textCapSentences" android:maxLines="1" android:textColor="@color/on_surface" />
    <TextView android:id="@+id/panel_folder_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_large" android:text="@string/folder"
        android:textColor="@color/on_surface_variant" android:textSize="@dimen/text_small" />
    <Spinner android:id="@+id/panel_folder" android:layout_width="match_parent" android:layout_height="@dimen/row_height"
        android:spinnerMode="dropdown" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_large" android:gravity="end" android:orientation="horizontal">
        <Button android:id="@+id/panel_negative" style="@style/Widget.PokeLocation.PanelButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel" />
        <Button android:id="@+id/panel_positive" style="@style/Widget.PokeLocation.PanelButton.Filled"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap" android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
