<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/gap"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="@dimen/gap"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_folder"
            android:tint="@color/primary" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="@dimen/gap"
            android:paddingBottom="@dimen/gap">
            <TextView
                android:id="@+id/fav_folder_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/fav_folder_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:id="@+id/fav_folder_open" android:layout_width="40dp" android:layout_height="40dp"
            android:contentDescription="@string/fav_cd_open" android:scaleType="center"
            android:src="@drawable/ic_chevron_right" android:tint="@color/on_surface_variant" />
        <ImageView android:id="@+id/fav_folder_drag" android:layout_width="40dp" android:layout_height="40dp"
            android:contentDescription="@string/fav_cd_drag" android:scaleType="center"
            android:src="@drawable/ic_drag" android:tint="@color/on_surface_variant" android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
