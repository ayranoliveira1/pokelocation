<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de item (import: waypoint/rota/track/segmento; export: favorito/rota). paddingStart ajustado pelo nível no bind. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gap_large"
    android:paddingTop="@dimen/gap"
    android:paddingEnd="@dimen/gap"
    android:paddingBottom="@dimen/gap">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gpx_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/gpx_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_surface_variant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/gpx_sub2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/on_surface_variant"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/gpx_saved"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/gap"
        android:contentDescription="@string/gpx_cd_saved"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="@color/success" />

    <ImageButton
        android:id="@+id/gpx_action"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/gpx_cd_add"
        android:src="@drawable/ic_add"
        app:tint="@color/primary" />
</LinearLayout>
